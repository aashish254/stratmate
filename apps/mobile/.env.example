# RevenueCat (in-app purchases)
EXPO_PUBLIC_REVENUE_CAT_APP_STORE_API_KEY=your-revenuecat-ios-key
EXPO_PUBLIC_REVENUE_CAT_PLAY_STORE_API_KEY=your-revenuecat-android-key
EXPO_PUBLIC_REVENUE_CAT_TEST_STORE_API_KEY=your-revenuecat-test-key
